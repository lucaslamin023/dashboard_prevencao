# Conexão MongoDB Atlas
MONGO_URL=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/prevencao_perdas?retryWrites=true&w=majority

# Porta da API
PORT=5000

# URL do Frontend (CORS) - no Render, preencha com a URL do Static Site (ex: https://prevencao-web.onrender.com)
CLIENT_URL=http://localhost:3000

# Ambiente
NODE_ENV=production
